---
import { loadTranslations, t, getLocalizedHashLink } from '../utils/i18n';
import type { Locale } from '../i18n/types';

const locale = Astro.currentLocale as Locale;
const translations = await loadTranslations(locale);

const iconPaths = {
	music:
		'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3',
	shield:
		'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
	book:
		'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
} as const;

const highlights = [
	{
		id: 'adhdNoise',
		icon: 'music',
		summaryKey: 'aboutBinauralBeats.adhdNoise.subtitle',
		detailKey: 'aboutBinauralBeats.adhdNoise.description',
	},
	{
		id: 'adhdBinaural',
		icon: 'music',
		summaryKey: 'aboutBinauralBeats.adhdBinaural.subtitle',
		detailKey: 'aboutBinauralBeats.adhdBinaural.description',
	},
	{
		id: 'safety',
		icon: 'shield',
		summaryKey: 'aboutBinauralBeats.safety.subtitle',
		detailKey: 'aboutBinauralBeats.safety.general',
	},
	{
		id: 'research',
		icon: 'book',
		summaryKey: 'aboutBinauralBeats.research.subtitle',
		detailKey: 'aboutBinauralBeats.research.findings',
	},
] as const;

const titleKeys: Record<(typeof highlights)[number]['id'], string> = {
	adhdNoise: 'aboutBinauralBeats.adhdNoise.title',
	adhdBinaural: 'aboutBinauralBeats.adhdBinaural.title',
	safety: 'aboutBinauralBeats.safety.title',
	research: 'aboutBinauralBeats.research.title',
};
---

<div class="research-highlights" aria-label={t('aboutBinauralBeats.research.title', locale, translations)}>
	<div class="research-highlights__grid">
		{highlights.map((item) => (
			<article class="research-highlights__item">
				<div class="research-highlights__icon" aria-hidden="true">
					<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d={iconPaths[item.icon]}
						/>
					</svg>
				</div>
				<h3 class="research-highlights__title">
					{t(titleKeys[item.id], locale, translations)}
				</h3>
				<p class="research-highlights__summary">
					{t(item.summaryKey, locale, translations)}
				</p>
				<p class="research-highlights__detail">
					{t(item.detailKey, locale, translations)}
				</p>
			</article>
		))}
	</div>

	<div class="research-highlights__more">
		<span class="research-highlights__rule" aria-hidden="true"></span>
		<a class="research-highlights__link" href={getLocalizedHashLink('#research-studies', locale)}>
			<span>{t('aboutBinauralBeats.readMore', locale, translations)}</span>
			<svg viewBox="0 0 48 16" aria-hidden="true">
				<path d="M1 8h43m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
			</svg>
		</a>
	</div>
</div>

<style>
	.research-highlights {
		background: #fffaf7;
		padding: clamp(2rem, 4vw, 3rem) 0 clamp(2.5rem, 5vw, 3.5rem);
	}

	.research-highlights__grid {
		display: grid;
		gap: clamp(1.75rem, 3vw, 2.5rem);
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.research-highlights__item {
		display: grid;
		gap: 0.85rem;
	}

	.research-highlights__icon {
		align-items: center;
		color: #e66a00;
		display: flex;
		height: 3.25rem;
		justify-content: center;
		margin: 0 auto;
		width: 3.25rem;
	}

	.research-highlights__icon svg {
		display: block;
		height: 2.75rem;
		width: 2.75rem;
	}

	.research-highlights__title {
		color: #5e4f46;
		font-family: var(--font-body);
		font-size: clamp(1.15rem, 0.95rem + 0.45vw, 1.45rem);
		font-weight: var(--font-weight-card-title);
		line-height: 1.08;
		margin: 0;
		text-wrap: balance;
	}

	.research-highlights__summary {
		color: #5e4f46;
		font-family: var(--font-copy);
		font-size: clamp(1rem, 0.92rem + 0.25vw, 1.15rem);
		font-weight: var(--font-weight-body);
		line-height: 1.22;
		margin: 0;
	}

	.research-highlights__detail {
		color: rgba(94, 79, 70, 0.62);
		display: -webkit-box;
		font-family: var(--font-copy);
		font-size: clamp(0.98rem, 0.9rem + 0.2vw, 1.08rem);
		font-weight: var(--font-weight-body);
		line-height: 1.22;
		margin: 0;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
		overflow: hidden;
	}

	.research-highlights__more {
		align-items: center;
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr auto;
		margin-top: clamp(2rem, 4vw, 3rem);
	}

	.research-highlights__rule {
		background: rgba(77, 46, 42, 0.26);
		height: 1px;
		width: 100%;
	}

	.research-highlights__link {
		align-items: center;
		border: 1px solid rgba(77, 46, 42, 0.32);
		border-radius: 999px;
		color: rgba(77, 46, 42, 0.72);
		display: inline-flex;
		font-family: var(--font-body);
		font-size: clamp(1.05rem, 0.95rem + 0.25vw, 1.25rem);
		font-weight: var(--font-weight-ui);
		gap: 0.65rem;
		line-height: 1;
		padding: 0.55rem 0.75rem 0.55rem 1rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.research-highlights__link svg {
		height: 0.9rem;
		width: 2.8rem;
	}

	.research-highlights__link:hover {
		background: rgba(244, 95, 17, 0.08);
		border-color: rgba(244, 95, 17, 0.46);
		color: #e66a00;
	}

	@media (max-width: 1023px) {
		.research-highlights__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.research-highlights__grid {
			grid-template-columns: 1fr;
		}

		.research-highlights__more {
			align-items: stretch;
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-color-scheme: dark) {
		.research-highlights {
			background: #fff7f0;
		}

		.research-highlights__title,
		.research-highlights__summary {
			color: #5e4f46;
		}

		.research-highlights__detail {
			color: rgba(94, 79, 70, 0.72);
		}
	}
</style>
