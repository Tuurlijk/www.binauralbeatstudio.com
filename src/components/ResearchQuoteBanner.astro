---
import { loadTranslations, t } from '../utils/i18n';
import type { Locale } from '../i18n/types';

const locale = Astro.currentLocale as Locale;
const translations = await loadTranslations(locale);
const base = import.meta.env.BASE_URL;
---

<aside
	class="research-quote-banner"
	aria-label={t('quotes.title', locale, translations)}
>
	<div
		class="research-quote-banner__bg"
		style={`--research-quote-bg: image-set(url("${base}images/quotes/quote-background-brown.webp") type("image/webp"), url("${base}images/quotes/quote-background-brown.png") type("image/png"));`}
		aria-hidden="true"
	></div>
	<div class="research-quote-banner__inner">
		<figure class="research-quote-banner__figure">
			<picture>
				<source srcset={`${base}images/quotes/young-student.webp`} type="image/webp" />
				<img
					src={`${base}images/quotes/young-student.png`}
					alt=""
					width="2236"
					height="1767"
					loading="lazy"
					decoding="async"
				/>
			</picture>
		</figure>

		<blockquote class="research-quote-banner__quote">
			<p class="research-quote-banner__text">
				"{t('quotes.quote2.text', locale, translations)}"
			</p>
			<cite class="research-quote-banner__source">
				{t('quotes.quote2.source', locale, translations)}
			</cite>
		</blockquote>
	</div>
</aside>

<style>
	.research-quote-banner {
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		position: relative;
	}

	.research-quote-banner__bg {
		background-image: var(--research-quote-bg);
		background-position: center bottom;
		background-repeat: no-repeat;
		background-size: cover;
		border-radius: 0;
		inset: 0;
		position: absolute;
	}

	.research-quote-banner__inner {
		align-items: end;
		display: grid;
		gap: clamp(1rem, 3vw, 2.5rem);
		grid-template-columns: minmax(13rem, 34%) minmax(0, 1fr);
		min-height: clamp(15rem, 22vw, 21rem);
		padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1rem, 4vw, 3rem) 0;
		position: relative;
		z-index: 1;
	}

	.research-quote-banner__figure {
		align-self: end;
		line-height: 0;
		margin: 0;
	}

	.research-quote-banner__figure picture,
	.research-quote-banner__figure img {
		display: block;
		width: 100%;
	}

	.research-quote-banner__figure img {
		height: auto;
		max-height: clamp(14rem, 23vw, 20.5rem);
		object-fit: contain;
		object-position: bottom center;
	}

	.research-quote-banner__quote {
		align-self: center;
		margin: 0;
		max-width: 42rem;
		padding-bottom: clamp(1.25rem, 3vw, 2.25rem);
	}

	.research-quote-banner__text {
		color: #5e4f46;
		font-family: var(--font-body);
		font-size: clamp(1.45rem, 1.05rem + 1.1vw, 2.35rem);
		font-weight: var(--font-weight-card-title);
		line-height: 1.08;
		margin: 0 0 0.75rem;
	}

	.research-quote-banner__source {
		color: #5e4f46;
		display: block;
		font-family: var(--font-body);
		font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.35rem);
		font-style: normal;
		font-weight: var(--font-weight-card-title);
		line-height: 1.2;
	}

	@media (max-width: 767px) {
		.research-quote-banner__inner {
			align-items: end;
			grid-template-columns: 1fr;
			min-height: auto;
			padding-inline: 1.25rem;
			padding-bottom: 0;
		}

		.research-quote-banner__figure {
			justify-self: center;
			max-width: 14rem;
		}

		.research-quote-banner__quote {
			align-self: stretch;
			max-width: none;
			padding-bottom: 1.25rem;
		}
	}

	@media (prefers-color-scheme: dark) {
		.research-quote-banner__text,
		.research-quote-banner__source {
			color: #fff7f0;
		}
	}
</style>
